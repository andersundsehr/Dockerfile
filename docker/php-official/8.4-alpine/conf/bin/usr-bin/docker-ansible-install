#!/usr/bin/env bash

IMAGE_FAMILY=$(docker-image-info family)

# Installation
case "$IMAGE_FAMILY" in
    Debian|Ubuntu)
        apt-install \
            python3 \
            ansible

        chmod 750 /usr/bin/ansible*
        ;;

    RedHat)
        yum-install \
            epel-release
        yum-install \
            python3 \
            ansible

        chmod 750 /usr/bin/ansible*
        ;;

    Alpine)
        apk-install \
            python3 \
            ansible

        chmod 750 /usr/bin/ansible*
        ;;
esac
docker-image-cleanup
