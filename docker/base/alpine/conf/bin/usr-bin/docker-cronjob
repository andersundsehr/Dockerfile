#!/usr/bin/env bash

set -o pipefail  # trace ERR through pipes
set -o errtrace  # trace ERR through 'time command' and other functions
set -o nounset   ## set -u : exit the script if you try to use an uninitialised variable
set -o errexit   ## set -e : exit the script if any statement returns a non-true return value

source /opt/docker/bin/config.sh

rootCheck "$0"

if [[ "$#" -eq 0 ]]; then
    echo "Usage: $0 '<cronjob line>'"
    exit 1
fi

if [[ "$(docker-image-info family)" == "Alpine" ]]; then
    # BusyBox crond reads one crontab per user from /etc/crontabs, without the user column
    for CRONJOB_LINE in "$@"; do
        if [[ ! "$CRONJOB_LINE" =~ ^[[:space:]]*(([^[:space:]]+[[:space:]]+){5})([^[:space:]]+)[[:space:]]+(.+)$ ]]; then
            echo "[ERROR] Not a cron job line with five time fields, a user and a command: $CRONJOB_LINE"
            exit 1
        fi

        CRONJOB_USER="${BASH_REMATCH[3]}"
        echo "${BASH_REMATCH[1]}${BASH_REMATCH[4]}" >> "/etc/crontabs/${CRONJOB_USER}"
        chmod 0600 "/etc/crontabs/${CRONJOB_USER}"
    done
    exit 0
fi

# create crontab file
touch /etc/cron.d/webdevops-docker
chmod 0644 /etc/cron.d/webdevops-docker

for CRONJOB_LINES in "$@"; do
    echo "$CRONJOB_LINES" >> /etc/cron.d/webdevops-docker
done

# Add required newline at end
echo >> /etc/cron.d/webdevops-docker
